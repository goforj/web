{
  "openapi": "3.0.3",
  "info": {
    "title": "Multi Controller App",
    "version": "1.0.0"
  },
  "paths": {
    "/files/{id}/download": {
      "get": {
        "operationId": "filesControllerDownload",
        "tags": [
          "Files"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "raw",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/users": {
      "post": {
        "operationId": "usersControllerCreate",
        "tags": [
          "Users"
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {}
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsersCreateUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "error",
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Bad Request"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "usersControllerGet",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {},
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UsersCreateUser": {
        "properties": {
          "email": {
            "nullable": true,
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
